{
  "name": "worldling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/service-worker.mjs",
    "test": "node --import tsx --test src/data/graph.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts index.html public/manifest.webmanifest README.md package.json tsconfig.json",
    "test:pwa": "node --test scripts/offline.test.mjs",
    "curation:report": "node --import tsx scripts/curation-report.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
